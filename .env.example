# Migrations run as the DB owner (superuser in dev).
DATABASE_URL=postgresql+psycopg://niyam:niyam@localhost:5432/niyam

# The FastAPI process authenticates with the owner URL in dev; app_engine
# calls SET ROLE niyam_app on every new physical connection, so RLS applies
# (niyam_app is NOBYPASSRLS). In prod, replace with a login-enabled app-role
# URL and password; SET ROLE then becomes a no-op.
APP_DATABASE_URL=postgresql+psycopg://niyam:niyam@localhost:5432/niyam

REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-real-env
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Display timezone (storage is always UTC)
DISPLAY_TZ=Asia/Kolkata
