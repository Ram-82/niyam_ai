# Niyam AI — canonical env vars.
# Copy to .env for local dev or inject via your secrets manager in prod.
# NEVER commit an .env file with real values; .env is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Owner DSN — used by Alembic and test seeding only. Bypasses RLS. In prod
# this is the postgres superuser (or a role with CREATEROLE + BYPASSRLS).
DATABASE_URL=postgresql+psycopg://niyam:niyam@postgres:5432/niyam

# App DSN — the credentials the API runs its own queries through. In dev
# this is the same URL as DATABASE_URL because the app SET ROLEs itself to
# niyam_app. In prod, prefer a dedicated login role with fewer grants.
APP_DATABASE_URL=postgresql+psycopg://niyam:niyam@postgres:5432/niyam

# Role that RLS policies scope to. Created by migration 0001. Do not
# change unless you also renamed the role in the DB.
APP_DB_ROLE=niyam_app

# ---------------------------------------------------------------------------
# Redis (token revocation + lockouts + RQ queue)
# ---------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------

# MUST be a strong random string in prod. Rotating this invalidates every
# outstanding token — plan a rotation window.
JWT_SECRET=change-me-to-32+-random-bytes

# Access token TTL (seconds). 15 minutes is our default.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token TTL (seconds). 14 days is our default.
JWT_REFRESH_TTL_SECONDS=1209600

# TTL for the short-lived token issued during TOTP setup (seconds).
TOTP_SETUP_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Localisation
# ---------------------------------------------------------------------------

# Timezone used to render dates + compute due-date rollovers.
DISPLAY_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where uploaded files land. Must be writable by UID 10001 (the container's
# `niyam` user in Dockerfile.prod). In prod this is a PVC or S3-backed mount.
UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------------------
# Worker queue
# ---------------------------------------------------------------------------

# When true, imports run in the RQ worker container; false runs them
# synchronously (used only in tests).
QUEUE_ASYNC=true

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to hit the API. Tighten in prod — do NOT
# use `*` when credentials mode is on.
NIYAM_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# stdlib log level. Structured JSON is emitted regardless.
NIYAM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# gunicorn (prod runtime — see backend/Dockerfile.prod)
# ---------------------------------------------------------------------------

# Number of gunicorn worker processes. Rule of thumb: (2 * cpu) + 1.
# Each worker holds its own DB pool, so multiply worker count by
# pool_size when sizing Postgres max_connections.
WEB_WORKERS=4

# ---------------------------------------------------------------------------
# GSP integration
# ---------------------------------------------------------------------------

# `mock` uses the in-tree gsp-mock server; `sandbox` / `prod` hit a real GSP.
GSP_MODE=mock
GSP_BASE_URL=http://gsp-mock:9000

# Token the scheduler-run endpoint accepts (for cron/systemd invocation).
GSP_SCHEDULER_TOKEN=

# Rotating list of Fernet keys (comma-separated) for encrypting GSP session
# blobs at rest. First key is the write key; later keys are decrypt-only
# for rotation.
GSP_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# Narrator (LLM 2-pager narration)
# ---------------------------------------------------------------------------

NARRATOR_ENABLED=false
NARRATOR_MODE=mock
NARRATOR_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp (client delivery)
# ---------------------------------------------------------------------------

WHATSAPP_ENABLED=false
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_REPORT_NAME=niyam_report_v1
WHATSAPP_TEMPLATE_CHASE_NAME=niyam_supplier_chase_v1

# ---------------------------------------------------------------------------
# Email (transactional: invites, password resets)
# ---------------------------------------------------------------------------
# Default OFF so a dev/demo instance can't accidentally send to real
# addresses. When OFF, the invite endpoint's UI copy-URL fallback is the
# only path — deliberate. When enabling in prod, also set
# EMAIL_APP_BASE_URL to the CA-facing dashboard origin (e.g.
# https://app.niyam.ai) or every invite link will point at localhost.

EMAIL_ENABLED=false
EMAIL_MODE=console
EMAIL_FROM=no-reply@niyam.ai
EMAIL_FROM_NAME=Niyam AI
EMAIL_APP_BASE_URL=http://localhost:3000
